{
  "name": "dosage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "check": "svelte-check",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:update-snapshots": "npm run build && UPDATE_E2E_DOCS=1 playwright test --update-snapshots"
  },
  "dependencies": {
    "katex": "^0.18.1",
    "svelte": "^5.56.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte-check": "^4.7.2",
    "vite": "^8.1.4"
  }
}
