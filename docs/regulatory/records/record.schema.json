{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dosage.invalid/schemas/regulatory-record-v1.json",
  "title": "Dosage controlled regulatory record source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "title",
    "kind",
    "template",
    "output",
    "revision",
    "status",
    "source_baseline",
    "summary",
    "required_fields",
    "sections",
    "decisions",
    "evidence",
    "approvals"
  ],
  "properties": {
    "record_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": [
        "prototype_baseline",
        "inquiry_gate",
        "authorization_gate",
        "submission",
        "correspondence",
        "support"
      ]
    },
    "template": { "type": "string", "pattern": "^[a-z0-9-]+\\.md\\.mustache$" },
    "output": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]*\\.md$" },
    "revision": { "type": "string", "minLength": 1 },
    "status": { "enum": ["incomplete", "in_review", "approved", "superseded"] },
    "source_baseline": { "type": ["string", "null"] },
    "supersedes": { "type": ["string", "null"] },
    "summary": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "required_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": ["string", "null"] },
          "required": { "type": "boolean", "default": true }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "approvals": {
      "type": "array",
      "items": { "$ref": "#/$defs/approval" }
    },
    "change_triggers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "completion_statement": { "type": ["string", "null"] }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "number", "boolean", "null"] },
        "evidence_ref": { "type": ["string", "null"] },
        "required": { "type": "boolean" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "decision", "rationale", "evidence_ref", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
        "question": { "type": "string", "minLength": 1 },
        "decision": { "type": ["string", "null"] },
        "rationale": { "type": ["string", "null"] },
        "evidence_ref": { "type": ["string", "null"] },
        "required": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "reference", "status", "required"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]*$" },
        "description": { "type": "string", "minLength": 1 },
        "reference": { "type": ["string", "null"] },
        "status": { "enum": ["missing", "draft", "reviewed", "accepted", "not_applicable"] },
        "required": { "type": "boolean" }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "scope", "name", "organization", "decision", "date", "signature_ref", "required"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "organization": { "type": ["string", "null"] },
        "decision": { "enum": [null, "approved", "rejected", "conditional"] },
        "date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "signature_ref": { "type": ["string", "null"] },
        "required": { "type": "boolean" }
      }
    }
  }
}
